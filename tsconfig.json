{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Node runs these .ts files directly by stripping types, and the dev
    // server does the same transform on the way to the browser. Nothing is
    // ever emitted, so imports name the real file -- ./foo.ts, not the ./foo.js
    // that a compiled build would have produced.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,

    // Node's type stripping cannot handle constructs whose meaning depends on
    // types, so the compiler is told to reject them here rather than letting
    // them fail at run time: no enums, no namespaces, no parameter properties.
    "erasableSyntaxOnly": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["sim/**/*.ts", "server/**/*.ts", "client/**/*.ts", "verify/**/*.ts"]
}
